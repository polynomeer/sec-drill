# Local development settings for the Control Plane. Copy the values into your shell or IDE run config.
# Never put real credentials here; this file is committed.
SECDRILL_DB_URL=jdbc:postgresql://127.0.0.1:5432/secdrill
SECDRILL_DB_USER=secdrill
# Matches compose.yaml. Local-only throwaway value, not a secret.
SECDRILL_DB_PASSWORD=secdrill-local-dev
# Apply Flyway migrations on start. Keep false outside local development (14: no runtime auto DDL).
SECDRILL_DB_MIGRATE_ON_START=true
SECDRILL_RABBITMQ_USER=secdrill
# Matches compose.yaml. Local-only throwaway value, not a secret.
SECDRILL_RABBITMQ_PASSWORD=secdrill-local-dev
# Run with the local profile to enable dev-login and localhost origins.
SPRING_PROFILES_ACTIVE=local
# Optional OIDC provider for local testing (ADR 0002). Leave unset to use dev-login only.
# SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_OIDC_ISSUER_URI=
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_OIDC_CLIENT_ID=
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_OIDC_CLIENT_SECRET=
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_OIDC_SCOPE=openid
