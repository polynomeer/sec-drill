    "ChallengeKind": {"values": ["FLAG", "OBJECTIVE"], "source": "14"},
    "ArtifactSensitivity": {"values": ["LEARNER", "PRIVATE_ORACLE", "RAW_LOG", "PUBLIC_SUMMARY"], "source": "14"},
    "EvidenceSource": {"values": ["CONTROL", "VERIFIER", "SUPERVISOR", "COLLECTOR", "USER", "SIMULATOR"], "source": "14"},
    "TrustLevel": {"values": ["SERVER_VERIFIED", "OBSERVED", "USER_REPORTED", "SIMULATED"], "source": "14"},
    "EventType": {"values": ["SessionCreated", "LabRequested", "LabReady", "SubmissionAccepted", "ExecutionCompleted", "EvaluationCommitted", "ActionApplied", "LabTerminationRequested", "LabTerminated", "SessionFinished"], "source": "16"},
