    "SessionStatus": {"values": ["CREATED", "ACTIVE", "SUBMITTED", "EVALUATING", "COMPLETED", "CANCELLED", "EXPIRED", "EVALUATION_FAILED"], "terminal": ["COMPLETED", "CANCELLED", "EXPIRED"], "source": "13"},
