    "JobState": {"values": ["PENDING", "DISPATCHED", "LEASED", "RUNNING", "SUCCEEDED", "RETRY_WAIT", "FAILED", "CANCELLED"], "terminal": ["SUCCEEDED", "FAILED", "CANCELLED"], "source": "13"},
    "SubmissionKind": {"values": ["FLAG", "OBJECTIVE", "PATCH", "DETECTION", "POSTMORTEM"], "source": "15"},
